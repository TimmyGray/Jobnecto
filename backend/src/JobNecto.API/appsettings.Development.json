{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Postgres": "POSTGRES_CONNECTION_STRING"
  },
  "JwtSettings": {
    "Issuer": "JobNecto",
    "Audience": "JobNecto-API",
    "SecretKey": "JWT_SECRET_KEY",
    "ExpirationMinutes": 36000
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "https://localhost:5173"
    ]
  }
}
