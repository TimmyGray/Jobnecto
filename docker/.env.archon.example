# Copy this file to docker/.env.archon and fill your own values.
# Do NOT commit docker/.env.archon.

# Host port exposed for Archon API/Web
ARCHON_HOST_PORT=3093

# GitHub access for adapters/workflows
GH_TOKEN=
GITHUB_TOKEN=

# Use Claude global login in the container (recommended)
CLAUDE_USE_GLOBAL_AUTH=true

# Optional: needed for PostgreSQL MCP workflows
# Example format only (replace placeholders):
# postgresql://<db_user>:<db_password>@host.docker.internal:5432/<db_name>
DATABASE_URL=
